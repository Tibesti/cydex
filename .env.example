# Copy to .env and fill in: cp .env.example .env
# Vite only reads .env at startup: restart `npm run dev` after editing.
# NOTE: every VITE_* value is bundled into the browser JS and is publicly readable.
# Leave optional values blank rather than using placeholder text - blank falls back to the code default.

# --- Supabase (required) ---
# URL: https://<project-ref>.supabase.co (ref is in the dashboard URL, or use the Connect button)
# Key: Project Settings -> API Keys -> anon public (legacy) or publishable
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- App ---
# Squad redirects here after checkout. Set to the live URL when deployed.
VITE_APP_URL=http://localhost:8080
# "production" forces live Squad keys/API even under `npm run dev`.
VITE_NODE_ENV=development

# --- Google Maps (customer address search + map pin) ---
# Google Cloud console -> APIs & Services -> Credentials -> API key.
# Enable: Places API (New), Maps JavaScript API, Geocoding API.
# Restrict the key to your site URLs (e.g. http://localhost:8080/*) and those 3 APIs.
VITE_GOOGLE_MAPS_API_KEY=

# --- Squad sandbox (used by `npm run dev`) ---
# Squad sandbox dashboard -> API keys
VITE_SQUAD_PUBLIC_KEY=
VITE_SQUAD_SECRET_KEY=
VITE_SQUAD_API_URL=https://sandbox-api-d.squadco.com

# --- Squad live (used by `npm run build` / preview / Vercel) ---
# Squad live dashboard -> API keys (requires completed KYC)
VITE_SQUAD_PROD_PUBLIC_KEY=
VITE_SQUAD_PROD_SECRET_KEY=

# --- Squad payouts / virtual accounts ---
# Merchant ID from the Squad dashboard
VITE_SQUAD_MERCHANT_ID=
VITE_SQUAD_VIRTUAL_ACCOUNT_PREFIX=CYDEX

# Only needed once a server-side webhook endpoint exists
VITE_SQUAD_WEBHOOK_SECRET=
